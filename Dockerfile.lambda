# faultline: AWS Lambda 컨테이너 이미지. Lambda Web Adapter 가 함수 URL 요청을 uvicorn(8000)에 넘겨 준다.
# 빌드와 배포는 deploy/aws/lambda.sh 가 한다. 일반 서버용 이미지는 Dockerfile 이다.
FROM python:3.12-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --upgrade pip
COPY pyproject.toml README.md ./
COPY src ./src
RUN /opt/venv/bin/pip install .

FROM python:3.12-slim
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp \
    FAULTLINE_ARTIFACT_DIR=/app/artifacts PORT=8000 OMP_NUM_THREADS=2 \
    AWS_LWA_PORT=8000 AWS_LWA_READINESS_CHECK_PATH=/health
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.0 /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=builder /opt/venv /opt/venv
COPY artifacts /app/artifacts
WORKDIR /app
CMD ["sh", "-c", "exec uvicorn faultline.api.main:app --host 0.0.0.0 --port ${PORT}"]
